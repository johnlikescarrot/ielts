{
  "manifest_version": 3,
  "name": "Focus IELTS — private practice companion",
  "version": "0.1.0",
  "description": "A free, login-free, local-first IELTS review and shadowing companion.",
  "icons": {
    "48": "icons/icon.svg",
    "96": "icons/icon.svg"
  },
  "action": {
    "default_title": "Focus IELTS",
    "default_popup": "popup.html",
    "default_icon": "icons/icon.svg"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "permissions": ["storage", "contextMenus"],
  "browser_specific_settings": {
    "gecko": {
      "id": "focus-ielts@focusielts.app",
      "strict_min_version": "121.0"
    }
  }
}
