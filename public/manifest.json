{
  "manifest_version": 3,
  "name": "IELTS Forge — Private Practice",
  "version": "1.0.0",
  "description": "Turn the web into private, evidence-informed IELTS practice. Free, local-first, and login-free.",
  "browser_specific_settings": {
    "gecko": {
      "id": "ielts-forge@johnlikescarrot.github.io",
      "strict_min_version": "115.0"
    }
  },
  "permissions": ["storage", "activeTab", "scripting"],
  "action": {
    "default_title": "IELTS Forge",
    "default_popup": "index.html",
    "default_icon": {
      "32": "icons/icon-32.svg",
      "48": "icons/icon-48.svg",
      "96": "icons/icon-96.svg"
    }
  },
  "options_ui": {
    "page": "index.html#/settings",
    "open_in_tab": true
  },
  "icons": {
    "32": "icons/icon-32.svg",
    "48": "icons/icon-48.svg",
    "96": "icons/icon-96.svg"
  }
}
