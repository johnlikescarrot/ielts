{
  "manifest_version": 3,
  "name": "IELTS Compass — Private Practice",
  "version": "1.0.0",
  "description": "Free, local-first IELTS vocabulary, speaking and writing practice. No account, no tracking.",
  "permissions": ["storage", "contextMenus"],
  "background": { "scripts": ["background.js"] },
  "action": {
    "default_title": "Open IELTS Compass"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "ielts-compass@johnlikescarrot.github.io",
      "strict_min_version": "142.0",
      "data_collection_permissions": { "required": ["none"] }
    }
  },
  "commands": {
    "open-compass": {
      "suggested_key": { "default": "Alt+Shift+I" },
      "description": "Open IELTS Compass"
    }
  }
}
