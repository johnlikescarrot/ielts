{
  "name": "ielts-slayer-firefox",
  "version": "0.1.0",
  "private": true,
  "description": "A free, offline-first Firefox extension for IELTS practice.",
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit && node scripts/build.mjs",
    "test": "vitest run --coverage",
    "coverage": "vitest run --coverage",
    "lint": "eslint .",
    "lint:super-linter": "docker run --rm -e RUN_LOCAL=true -e DEFAULT_BRANCH=main -v \"$PWD:/tmp/lint\" github/super-linter:latest",
    "astrix": "npx astryx check ."
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "@vitest/coverage-v8": "^2.1.8",
    "eslint": "^9.17.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
