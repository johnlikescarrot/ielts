{
  "name": "bandcraft-firefox",
  "version": "1.0.0",
  "description": "A private, local-first IELTS practice studio for Firefox.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "astryx": "node node_modules/@astryxdesign/cli/clients/cli/bin/astryx.mjs",
    "build": "npm run typecheck && vite build && node scripts/build-extension.mjs",
    "dev": "vite --host 0.0.0.0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings=0",
    "package": "npm run build && web-ext build --source-dir dist --artifacts-dir artifacts --overwrite-dest",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "validate": "npm run format:check && npm run lint && npm run typecheck && npm run test:coverage && npm run build && web-ext lint --source-dir dist"
  },
  "dependencies": {
    "@astryxdesign/core": "0.6.3",
    "@astryxdesign/theme-neutral": "0.6.3",
    "@stylexjs/stylex": "0.19.1",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "ts-fsrs": "5.4.2"
  },
  "devDependencies": {
    "@astryxdesign/cli": "0.6.3",
    "@eslint/js": "9.36.0",
    "@testing-library/jest-dom": "6.8.0",
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "14.6.1",
    "@types/firefox-webext-browser": "143.0.0",
    "@types/node": "24.5.2",
    "@types/react": "19.1.16",
    "@types/react-dom": "19.1.9",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/coverage-v8": "5.0.2",
    "eslint": "9.36.0",
    "eslint-plugin-react-hooks": "5.2.0",
    "eslint-plugin-react-refresh": "0.4.20",
    "esbuild": "0.28.2",
    "globals": "16.4.0",
    "jsdom": "30.1.1",
    "prettier": "3.6.2",
    "typescript": "5.9.2",
    "typescript-eslint": "8.44.1",
    "vite": "8.3.1",
    "vitest": "5.0.2",
    "web-ext": "10.7.0"
  }
}
