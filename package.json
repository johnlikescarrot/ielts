{
  "name": "ielts-slayer-firefox",
  "version": "1.1.0",
  "description": "Free, no-login, privacy-first IELTS preparation for Firefox with local video-caption practice and English/Vietnamese support.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:coverage": "vitest run && vitest run --config vitest.core.config.ts tests/video/transcriptStudio.test.ts --coverage",
    "test:watch": "vitest",
    "lint": "eslint . --ext .ts,.tsx",
    "typecheck": "tsc --noEmit",
    "test:coverage:all": "vitest run --coverage",
    "astryx": "astryx"
  },
  "dependencies": {
    "@astryxdesign/core": "^0.6.3",
    "@astryxdesign/theme-neutral": "^0.6.3",
    "@stylexjs/stylex": "^0.19.1",
    "lucide-react": "^0.475.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@astryxdesign/cli": "^0.6.3",
    "@eslint/js": "^9.20.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.13.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^5.0.2",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.20.1",
    "globals": "^15.15.0",
    "jsdom": "^26.0.0",
    "postcss": "^8.5.2",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.24.0",
    "vite": "^6.1.0",
    "vitest": "^5.0.2"
  },
  "astryx": {
    "theme": "neutral"
  }
}
