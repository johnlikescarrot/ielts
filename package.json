{
  "name": "ielts-slayer-firefox",
  "version": "1.1.0",
  "description": "Top-tier, 100% Free & Privacy-first IELTS Preparation Suite for Firefox with AST Analysis and Dual English/Vietnamese Support",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "lint": "eslint . --ext .ts,.tsx",
    "typecheck": "tsc --noEmit",
    "astryx": "node node_modules/@astryxdesign/cli/clients/cli/bin/astryx.mjs",
    "test:coverage:video": "vitest run tests/video/** tests/components/videoLab.test.tsx tests/components/shadowingStudio.test.tsx --coverage --coverage.reportsDirectory=coverage/video --coverage.include='src/video/**' --coverage.include='src/components/video/**'",
    "lint:styles": "stylelint 'src/**/*.css' 'public/**/*.css'",
    "lint:docs": "markdownlint README.md docs/RESEARCH.md",
    "lint:html": "htmlhint '*.html'"
  },
  "dependencies": {
    "@astryxdesign/core": "^0.6.3",
    "@astryxdesign/theme-neutral": "^0.6.3",
    "@stylexjs/stylex": "^0.19.1",
    "lucide-react": "^0.475.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@astryxdesign/cli": "^0.6.3",
    "@eslint/js": "^9.20.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.13.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^5.0.2",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.20.1",
    "globals": "^15.15.0",
    "htmlhint": "^1.9.2",
    "jsdom": "^26.0.0",
    "markdownlint-cli": "^0.49.1",
    "postcss": "^8.5.2",
    "stylelint": "^16.26.1",
    "stylelint-config-standard": "^36.0.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.24.0",
    "vite": "^6.1.0",
    "vitest": "^5.0.2"
  },
  "astryx": {
    "theme": "@astryxdesign/theme-neutral"
  }
}
