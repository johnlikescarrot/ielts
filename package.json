{
  "name": "ielts-forge",
  "version": "1.0.0",
  "private": true,
  "description": "A private, local-first IELTS practice companion for Firefox",
  "type": "module",
  "scripts": {
    "astryx": "node node_modules/@astryxdesign/cli/clients/cli/bin/astryx.mjs",
    "build": "tsc --noEmit && vite build",
    "dev": "vite --host 0.0.0.0",
    "lint": "eslint . --max-warnings 0",
    "format:check": "prettier --check .",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "check": "npm run format:check && npm run lint && npm run test && npm run build",
    "package": "npm run build && cd dist && zip -r ../ielts-forge-firefox.zip ."
  },
  "dependencies": {
    "@astryxdesign/core": "0.6.3",
    "@astryxdesign/theme-neutral": "0.6.3",
    "@stylexjs/stylex": "0.19.0",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@astryxdesign/cli": "0.6.3",
    "@eslint/js": "9.36.0",
    "@types/firefox-webext-browser": "120.0.4",
    "@types/react": "19.1.16",
    "@types/react-dom": "19.1.9",
    "@vitejs/plugin-react": "5.0.4",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "9.36.0",
    "eslint-plugin-react-hooks": "5.2.0",
    "eslint-plugin-react-refresh": "0.4.22",
    "globals": "16.4.0",
    "prettier": "3.6.2",
    "typescript": "5.9.2",
    "typescript-eslint": "8.44.1",
    "vite": "7.3.6",
    "vitest": "4.1.11"
  },
  "engines": {
    "node": ">=20.19"
  },
  "astryx": {
    "theme": "@astryxdesign/theme-neutral"
  }
}
